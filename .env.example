# Copy to .env and adjust before running `docker compose up`.

# Secret used to sign JWTs in the backend. Use a long random string in production.
JWT_SECRET=change-me-in-production

# Public URLs the backend allows via CORS.
FRONTEND_URL=http://localhost:3001
ADMIN_PANEL_URL=http://localhost:3002

# Public URL of the backend itself (used for payment callback URLs and
# building uploaded product image URLs).
APP_URL=http://localhost:3000

# Shared secret for the blog article webhook (POST /api/articles/webhook/soro,
# sent as the x-webhook-secret header or ?secret=). The admin panel shows the
# webhook URL and this secret. Leave empty to reject all webhook posts.
ARTICLES_WEBHOOK_SECRET=

# Where uploaded product images are stored. Defaults to ./data/uploads
# locally; set to a path inside the persisted volume in Docker.
UPLOADS_DIR=

# PayGate.to (active payment gateway, card-to-crypto, no KYC/KYB, no account —
# this is the infrastructure NexaPay itself resells). Self-custodial EVM
# wallet on Polygon; this is where all payouts land, no dashboard involved.
PAYGATE_MERCHANT_WALLET=
# Self-custodial BTC wallet, used both for the card/onramp path's Bitcoin
# payout option and for direct wallet-to-wallet Bitcoin payments.
PAYGATE_BTC_WALLET=

# NexaPay (inactive — kept wired for rollback until PayGate is confirmed live).
# Register the webhook secret under Dashboard -> Settings -> Webhooks; the
# webhook URL itself is set per-payment (callback_url), not globally.
NEXAPAY_API_KEY=
NEXAPAY_WEBHOOK_SECRET=
# One of: USDC, POL, LINK, UNI (all settle on Polygon).
NEXAPAY_CRYPTO_ASSET=USDC

# BTCPay Server (inactive — kept wired for rollback until NexaPay is confirmed live).
# Register the webhook endpoint (event: InvoiceSettled/InvoiceExpired/InvoiceInvalid)
# at: <APP_URL>/api/webhooks/btcpay under Store Settings -> Webhooks, and paste
# the secret it generates below.
BTCPAY_URL=http://localhost:14142
BTCPAY_API_KEY=
BTCPAY_STORE_ID=
BTCPAY_WEBHOOK_SECRET=

# B2BinPay crypto gateway (inactive — legacy/alternate provider).
B2BINPAY_API_URL=https://api.b2binpay.com
B2BINPAY_API_KEY=
B2BINPAY_API_SECRET=
B2BINPAY_WALLET_ID=
